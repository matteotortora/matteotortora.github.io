{
  "name": "matteo-tortora-academic-site",
  "homepage": "https://matteotortora.github.io",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.23.5 <23",
    "npm": ">=10.9.9 <11"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "5.18.0",
    "classnames": "2.5.1",
    "d3-geo": "3.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intersection-observer": "9.16.0",
    "react-router-dom": "7.18.5",
    "react-router-hash-link": "2.4.3"
  },
  "scripts": {
    "predeploy": "npm run check",
    "deploy": "gh-pages -b master -d build",
    "start": "vite",
    "build": "node scripts/build-site.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs",
    "check:security": "node scripts/check-security.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run check:security && npm test && npm run audit && npm run build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "gh-pages": "6.3.0",
    "sass": "1.108.2",
    "vite": "8.3.8"
  }
}
